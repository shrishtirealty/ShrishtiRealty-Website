# ── Gmail SMTP Config ────────────────────────────────────────────────────────
# The Gmail account that SENDS the email (also receives it if same as MAIL_TO)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=nuvibeshrishtirealty@gmail.com
SMTP_PASS=your-16-char-app-password

# ── Recipients ────────────────────────────────────────────────────────────────
# Primary TO address — who receives the form notifications
# Can be comma-separated for multiple: email1@gmail.com,email2@gmail.com
MAIL_TO=nuvibeshrishtirealty@gmail.com

# CC addresses (optional) — additional recipients copied on every email
# Comma-separated. Leave blank or remove to disable CC.
MAIL_CC=kiran@shrishtirealty.com

# ── Blog / Admin CMS (api/admin.mjs) ────────────────────────────────────────
# Secret used to sign admin login + OTP JWTs. Generate a long random string.
JWT_SECRET=replace-with-a-long-random-string

# Fallback admin login, only used if content/admin-credentials.json can't be
# reached (e.g. GITHUB_TOKEN not set). Once a password change is made via
# Settings, the GitHub-committed credentials file takes precedence.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Shrishti@2026
# Recipient for OTP emails when changing credentials (falls back to this if
# content/admin-credentials.json has no "email" field yet).
ADMIN_EMAIL=nuvibeshrishtirealty@gmail.com

# GitHub Personal Access Token (repo scope) used to commit published blog
# content/images to the site's own repo. Leave unset to use the local
# filesystem fallback during `vercel dev`.
GITHUB_TOKEN=
GITHUB_REPO=shrishtirealty/ShrishtiRealty-Website
GITHUB_BRANCH=main
