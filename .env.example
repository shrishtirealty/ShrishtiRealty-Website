# ── Gmail SMTP Config ────────────────────────────────────────────────────────
# The Gmail account that SENDS the email (also receives it if same as MAIL_TO)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=nuvibeshrishtirealty@gmail.com
SMTP_PASS=your-16-char-app-password

# ── Recipients ────────────────────────────────────────────────────────────────
# Primary TO address — who receives the form notifications
# Can be comma-separated for multiple: email1@gmail.com,email2@gmail.com
MAIL_TO=nuvibeshrishtirealty@gmail.com

# CC addresses (optional) — additional recipients copied on every email
# Comma-separated. Leave blank or remove to disable CC.
MAIL_CC=kiran@shrishtirealty.com
